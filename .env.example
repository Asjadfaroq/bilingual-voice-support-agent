# LiveKit Cloud project (Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ElevenLabs: used for both speech-to-text (Scribe realtime) and text-to-speech
ELEVEN_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# HubSpot service key with contacts and tickets read/write scopes
HUBSPOT_ACCESS_TOKEN=
# Use https://api.hubapi.com for accounts outside the EU data centre
HUBSPOT_BASE_URL=https://api-eu1.hubapi.com

# Local pgvector from docker compose
DATABASE_URL=postgresql://voice_agent:voice_agent@localhost:5434/voice_agent

# Local Langfuse tracing (optional): docker compose --profile langfuse up -d
# Pick any values; the stack creates this project, its keys and the UI user at first start.
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
# 64 hex characters: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
